# ──────────────────────────────────────────────────────────────────────────────
# Configurações do Pagar.me
# Obtenha suas chaves em: https://dashboard.pagar.me/
# ──────────────────────────────────────────────────────────────────────────────

# Chave secreta usada pelo backend para autenticar chamadas à API do Pagar.me
# e para validar a assinatura HMAC dos webhooks.
PAGARME_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────────────────────────────────────────────
# Configurações do backend / API C#
# ──────────────────────────────────────────────────────────────────────────────

# URL base da API C# que expõe os endpoints /api/repasses, /api/pagamentos/pix, etc.
API_BASE_URL=https://sua-api.com

# ──────────────────────────────────────────────────────────────────────────────
# Configurações do servidor de webhook (webhook.js)
# ──────────────────────────────────────────────────────────────────────────────

# Porta em que o servidor de webhook Node.js irá escutar (padrão: 3001)
PORT=3001
